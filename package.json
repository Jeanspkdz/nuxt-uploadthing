{
  "name": "nuxt-uploadthing",
  "version": "1.3.0",
  "description": "Nuxt module for seamless UploadThing integration with type-safe file routers and auto-generated components.",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jeanspkdz/nuxt-uploadthing"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs",
      "style": "./dist/runtime/uploadthing-tw.css"
    }
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "workspaces": [
    "playground"
  ],
  "scripts": {
    "prepack": "nuxt-module-build build",
    "dev": "npm run dev:prepare && nuxt dev playground",
    "dev:build": "nuxt build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare playground",
    "dev:mod:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare",
    "release": "pnpm lint && pnpm test && pnpm prepack && changelogen --release && pnpm publish && git push --follow-tags",
    "lint": "eslint .",
    "test": "vitest run --exclude test/packed-package.test.ts",
    "test:watch": "vitest watch",
    "test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit",
    "test:packed": "vitest run test/packed-package.test.ts"
  },
  "dependencies": {
    "@nuxt/kit": "^4.4.2",
    "@uploadthing/vue": "^7.3.3",
    "defu": "^6.1.7",
    "pathe": "^2.0.3"
  },
  "devDependencies": {
    "@nuxt/devtools": "^3.2.4",
    "@nuxt/eslint-config": "^1.15.2",
    "@nuxt/module-builder": "^1.0.2",
    "@nuxt/schema": "^4.4.2",
    "@nuxt/test-utils": "^4.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "latest",
    "@vue/server-renderer": "^3.5.32",
    "@vue/test-utils": "^2.5.1",
    "changelogen": "^0.6.2",
    "eslint": "^10.2.0",
    "jsdom": "^30.1.3",
    "nuxt": "^4.4.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "uploadthing": "^7.7.4",
    "vitest": "^4.1.4",
    "vue": "^3.5.32",
    "vue-tsc": "^3.2.6"
  },
  "peerDependencies": {
    "uploadthing": "^7.7.4"
  }
}
